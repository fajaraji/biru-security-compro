---
import { ShieldCheck } from 'lucide-astro';

const { lang = 'id' } = Astro.props;
const isId = lang === 'id';

const content = {
  title: isId ? 'Tentang Kami' : 'About Us',
  desc: isId
    ? 'Kami menyediakan Jasa Keamanan profesional, andal, dan tepercaya untuk menjaga perkantoran, pabrik, pasar, hotel, apartemen, rumah sakit, pusat perbelanjaan, kawasan industri, hingga kompleks perumahan. Operasional kami didukung penuh oleh infrastruktur Teknologi Informasi terintegrasi, aplikasi pemantauan khusus tugas di lapangan, serta pengawasan konstan 24/7 dari Command Center Service BIRU.'
    : 'We provide professional, reliable, and trusted Security Services to safeguard offices, factories, markets, hotels, apartments, hospitals, shopping centers, industrial estates, and residential complexes. Our operations are fully supported by integrated Information Technology infrastructure, specialized field monitoring applications, and constant 24/7 surveillance from the BIRU Command Center Service.',
  statClients: '500+',
  statClientsLabel: isId ? 'Corporate Clients' : 'Corporate Clients',
  statPartners: '45+',
  statPartnersLabel: isId ? 'Strategic Partnerships' : 'Strategic Partnerships',
  statInfra: 'Hi-End',
  statInfraLabel: isId ? 'Security Infrastructure' : 'Security Infrastructure',
};
---

<section id="about" class="py-20 bg-light">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      {/* Text Content */}
      <div>
        <div class="flex items-center mb-4">
          <ShieldCheck class="w-8 h-8 text-accent mr-3" />
          <h2 class="text-3xl md:text-4xl font-bold font-heading text-dark">
            {content.title}
          </h2>
        </div>
        <div class="w-20 h-1 bg-accent mb-8"></div>
        
        <p class="text-lg text-gray-700 leading-relaxed mb-10">
          {content.desc}
        </p>

        {/* Social Proof / Stats from BG */}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-8 border-t border-gray-200">
          <div>
            <div class="text-3xl font-extrabold text-primary mb-1">{content.statClients}</div>
            <div class="text-sm font-semibold text-gray-600 uppercase tracking-wider">{content.statClientsLabel}</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-primary mb-1">{content.statPartners}</div>
            <div class="text-sm font-semibold text-gray-600 uppercase tracking-wider">{content.statPartnersLabel}</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-primary mb-1">{content.statInfra}</div>
            <div class="text-sm font-semibold text-gray-600 uppercase tracking-wider">{content.statInfraLabel}</div>
          </div>
        </div>
      </div>

      {/* Visual Content */}
      <div class="relative">
        <div class="absolute inset-0 bg-primary translate-x-4 translate-y-4 rounded-xl -z-10"></div>
        <img 
          src="https://www.birusecurity.com/images/welcome.gif" 
          alt="BIRU Security Team" 
          class="w-full h-auto rounded-xl shadow-xl object-cover object-center aspect-[4/3]"
        />
      </div>

    </div>
  </div>
</section>
